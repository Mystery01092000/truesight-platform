# syntax=docker/dockerfile:1.7
# ---------------------------------------------------------------------------
# Argus one-off "toolbox" image — runs the READ-ONLY estate discovery CLIs
# (AWS + GitHub + Azure) as a single in-VPC Fargate task to populate the prod
# knowledge base. NOT the app image; never deployed as a service. All secrets
# are injected at runtime (SSM / task env), never baked into a layer.
# ---------------------------------------------------------------------------
FROM node:26-alpine AS toolbox
RUN apk add --no-cache libc6-compat
WORKDIR /app

# Install ALL deps (incl. tsx devDependency) — do NOT set NODE_ENV=production
# before this, or npm would omit devDependencies.
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

# App source (tsconfig paths "@/*" resolved by tsx at runtime).
COPY . .

# Each CLI is idempotent (upsert) and read-only against the cloud. Use `;` so a
# single provider failure does not block the others; logs report per-provider.
CMD ["sh", "-c", "node_modules/.bin/tsx db/sync-cli.ts; node_modules/.bin/tsx db/github-sync-cli.ts; node_modules/.bin/tsx db/azure-sync-cli.ts"]
