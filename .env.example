# =============================================================================
# Argus platform — environment reference.
# Copy to .env.cwt and fill from the workspace .env.cwt — NEVER commit real
# secrets. Values below are placeholders / safe local defaults only.
# =============================================================================

# ---- App --------------------------------------------------------------------
NODE_ENV=development
# Public base URL of the app (inlined into the client build at build time).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Signing key for sessions/cookies — generate a long random string per env.
SESSION_SECRET=replace-with-a-long-random-string
# Bootstrap DevOps Super Admin credentials (gated login).
ADMIN_EMAIL=admin@centricitywealth.tech
ADMIN_PASSWORD=change-me-in-real-env

# ---- Database (Postgres) ----------------------------------------------------
# Matches the docker-compose postgres service (user/pass/db = argus).
DATABASE_URL=postgres://argus:argus@localhost:5432/argus

# ---- Cache (Redis) ----------------------------------------------------------
# Optional. Leave blank to fall back to an in-process cache.
# Example: redis://localhost:6379
REDIS_URL=

# ---- AWS estate (read-only discovery) ---------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
# Account IDs across the Centricity estate (management / prod / dev).
AWS_MGMT_ACCOUNT_ID=
AWS_PROD_ACCOUNT_ID=
AWS_DEV_ACCOUNT_ID=
# Read-only role assumed in each account for estate exploration.
AWS_READONLY_ROLE_NAME=argus-readonly

# ---- Azure (service principal) ----------------------------------------------
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_NAME=Centricity-Oneinvictus
AZURE_RESOURCE_GROUP=rg-centricity-prod

# ---- GitHub (org observability) ---------------------------------------------
GITHUB_ORG=centricitywealthtech
# Personal access token with read access to the org's teams/repos.
GITHUB_PAT=

# ---- Terraform (state, referenced only) -------------------------------------
TERRAFORM_STATE_BUCKET=terraform-iac-data
# NOTE: Terraform/state operations reuse AWS_REGION (ap-south-1) above.
