# ---------------------------------------------------------------------------
# Truesight platform — Next.js 16 (Node 26, npm). Node/Next-appropriate ignores.
# ---------------------------------------------------------------------------

# Dependencies
node_modules/

# Next.js build output
.next/
out/
build/

# Environment / secrets — real values live in .env.local and are NEVER committed
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Vercel
.vercel

# Test coverage
coverage/

# Build info / generated typings
.turbo
tsconfig.tsbuildinfo
next-env.d.ts

# OS / editor cruft
.DS_Store

# ---------------------------------------------------------------------------
# Terraform (deploy/terraform) — only referenced by the platform, never applied
# from here. Ignore local state, caches and plans; KEEP the lock file (below).
# ---------------------------------------------------------------------------
deploy/terraform/.terraform/
deploy/terraform/*.tfstate
deploy/terraform/*.tfstate.*
*.tfplan
# tfvars may carry real values / overrides — never commit (use SSM for secrets)
*.tfvars
*.tfvars.json
!*.tfvars.example
# NOTE: .terraform.lock.hcl is intentionally NOT ignored — the provider lock
# file must be committed so every environment resolves identical provider
# versions (reproducible, drift-free plans).
deploy/terraform/tfplan*

# design-sync machine state
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules

# runtime lock
.observer.lock
